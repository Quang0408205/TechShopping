# Copy to .env (git-ignored) and fill in. Used by docker compose.

# Required: at least 32 random characters. Keep it fixed, otherwise every login token becomes invalid.
# PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
# Git Bash:   head -c 48 /dev/urandom | base64
JWT_SECRET=

# Optional, first start only: creates the first ADMIN if no ADMIN exists yet (password >= 8 characters).
# The values can be removed again afterwards.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: host port of the frontend (default 5510)
FRONTEND_PORT=5510

# Deploy for testers (docs: readme.md, section "Triển khai thử nghiệm"): the public address of the site, e.g.
# https://your-name.ngrok-free.app (no trailing slash). Stored in the links of uploaded images.
# Empty = http://localhost:8080 (local development).
APP_PUBLIC_BASE_URL=

# Bank transfer: the account the QR on the order page points to (use the real one in .env, never commit it).
# Empty = demo account 0123456789. PAYMENT_BANK_BIN: VietQR bank id (970436 Vietcombank, 970422 MB, 970407 Techcombank,
# 970415 VietinBank, 970418 BIDV, 970432 VPBank, 970423 TPBank). Account name: no accents, upper case.
PAYMENT_BANK_NAME=
PAYMENT_BANK_BIN=
PAYMENT_BANK_ACCOUNT_NUMBER=
PAYMENT_BANK_ACCOUNT_NAME=
# Shared key the bank webhook (POST /api/v1/payments/webhook) must send as "Authorization: Apikey <key>".
# Use a long random string; empty = webhook off.
PAYMENT_WEBHOOK_SECRET=
# Demo only: lets an ADMIN fake a "money received" notice on the Đối soát page, and a transfer order counts as paid
# after its QR has been on the payment page for one minute (keep false in real use)
PAYMENT_SIMULATOR_ENABLED=false

# Card payments ("Thẻ quốc tế") through Stripe Checkout, TEST mode only: Stripe pays out to no Vietnamese bank.
# https://dashboard.stripe.com/test/apikeys -> Secret key (sk_test_...). Empty = the card method is hidden.
STRIPE_SECRET_KEY=
# Optional: signing secret (whsec_...) of a webhook endpoint https://<public domain>/api/v1/payments/stripe/webhook
# (events checkout.session.completed, checkout.session.async_payment_succeeded). Without it the payment is still
# confirmed when the customer returns from Stripe to the payment page.
STRIPE_WEBHOOK_SECRET=

# Order emails (placed, payment received, confirmed, shipping, delivered, cancelled) sent to the address the customer
# typed at checkout. Gmail: make a Google account for the shop, turn on 2-step verification, then create an App Password
# (https://myaccount.google.com/apppasswords, 16 characters). Empty MAIL_USERNAME = nothing is sent (logged as SKIPPED).
MAIL_USERNAME=
MAIL_PASSWORD=
# Optional: sender name (default POY), another SMTP provider (MAIL_HOST / MAIL_PORT), switch mail off (MAIL_ENABLED=false)
MAIL_FROM_NAME=POY
# Optional: web address in the mail links; empty = APP_PUBLIC_BASE_URL, else http://localhost:5510
MAIL_SITE_URL=

# Account avatars on Cloudinary (https://console.cloudinary.com -> Settings -> API Keys). Any of the 3 empty = avatars
# are stored on this computer like product photos. Avatars are cropped square around the face and compressed.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI Service: LLM of the chatbot (recommendations need none of this)
# Default (free): Ollama on this computer. Install it, then: ollama pull qwen3:8b
#   LLM_PROVIDER=openai, LLM_BASE_URL=http://host.docker.internal:11434/v1, LLM_MODEL=qwen3:8b
#   (qwen3 models get LLM_REASONING_EFFORT=none automatically: no slow "thinking" step)
# Other OpenAI-compatible APIs (free tiers): set LLM_BASE_URL, LLM_API_KEY, LLM_MODEL of that provider
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Paid alternative: Claude. Set LLM_PROVIDER=anthropic and a key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional: Claude model (default claude-opus-5-5; cheaper: claude-sonnet-5-5, claude-haiku-5-5)
ANTHROPIC_MODEL=
# Optional: shared secret between backend and AI service (default dev-internal-key; set a random value in production)
AI_INTERNAL_KEY=
