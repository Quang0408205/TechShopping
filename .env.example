# Copy to .env (git-ignored) and fill in. Used by docker compose.

# Required: at least 32 random characters. Keep it fixed, otherwise every login token becomes invalid.
# PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
# Git Bash:   head -c 48 /dev/urandom | base64
JWT_SECRET=

# Optional, first start only: creates the first ADMIN if no ADMIN exists yet (password >= 8 characters).
# The values can be removed again afterwards.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional: host port of the frontend (default 5510)
FRONTEND_PORT=5510
